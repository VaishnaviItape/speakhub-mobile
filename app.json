{
  "expo": {
    "name": "Speak Hub",
    "slug": "speakhub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "speakhubmobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E11D48"
    },
    "ios": {
      "icon": "./assets/images/favicon.png",
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#E11D48"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/favicon.png"
      },
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#E11D48"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vaishnaviitape.speakhubmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E11D48",
          "image": "./assets/images/splash.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#E11D48"
          }
        }
      ],
      "expo-sharing",
      "expo-audio",
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59f15f23-7541-47c9-8fec-f26062f0e27a"
      }
    }
  }
}